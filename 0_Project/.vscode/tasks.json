{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++.exe アクティブなファイルのビルド",
            "command": "C:\\Program Files\\LLVM\\bin\\clang++.exe",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "デバッガーによって生成されたタスク。"
        },
        {
            "type": "cmake",
            "label": "CMake: ビルド",
            "command": "build",
            "targets": [
                "all"
            ],
            "preset": "__defaultBuildPreset__",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "CMake テンプレート ビルド タスク"
        }
    ],
    "version": "2.0.0"
}